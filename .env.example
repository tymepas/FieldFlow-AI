# Copy to .env (gitignored) and fill in. Never commit .env.

# Required. Read by @anthropic-ai/sdk for the Claude agent.
ANTHROPIC_API_KEY=

# Required. OpenWeather key, passed as the `appid` input to openweather.2.5.forecast.list
# (the CLI's managed key is sent as a header, which OpenWeather ignores; see docs/SWYTCHCODE-APIS.md).
OPENWEATHER_API_KEY=

# Optional. "mock" = clearly labelled simulated weather for demoing FLAG/RESCHEDULE.
# Unset = real OpenWeather forecast.
# WEATHER_PROVIDER=mock

# Optional overrides (defaults shown).
# ANTHROPIC_MODEL=claude-opus-5
# PORT=3000
# SLACK_CHANNEL=field-ops
# NOTION_ROOT_PAGE_ID=3e623caa-e128-81bf-aed0-ca92e92c83ec
# NOTION_TABLE_TITLE=Field Activities
